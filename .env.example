# Copie ce fichier en .env puis remplis-le
# Clé gratuite sur https://getsongbpm.com/api
GETSONGBPM_API_KEY=colle_ta_cle_ici
# Nombre d'analyses audio en parallèle (CPU)
ANALYSIS_WORKERS=2
# Adresse publique du site (fiches morceaux, sitemap). Vide = déduite automatiquement.
SITE_URL=
# Mets 1 quand le site est en HTTPS (cookie de connexion sécurisé)
COOKIE_SECURE=0
